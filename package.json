{
  "name": "minutes-studio",
  "version": "2.0.0",
  "private": true,
  "description": "録音・動画・PDFから議事録を作り、Wordで保存するブラウザ完結のWebアプリ",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "node --test src/*.test.mjs",
    "format": "prettier --write src index.html README.md docs",
    "format:check": "prettier --check src index.html"
  },
  "dependencies": {
    "docx": "^9.5.1",
    "docxtemplater": "^3.67.1",
    "mammoth": "^1.10.0",
    "pizzip": "^3.2.0"
  },
  "devDependencies": {
    "@xmldom/xmldom": "0.9.12",
    "prettier": "3.9.10",
    "vite": "8.0.13"
  }
}
