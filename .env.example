# サーバー専用。Sitesの環境変数に秘密値として登録し、再デプロイする。
GEMINI_API_KEY=
# キー登録後、共有試用を開始するときだけ true にする。
SHARED_DEMO_ENABLED=false

# モデルはGoogle AI Studioで利用可能なものを選ぶ（キー不要で画面に公開される設定）。
GEMINI_MODEL=gemini-3.5-flash-lite
# 上のキーが課金を有効にしたプロジェクトのものなら true（利用画面の無料枠警告を消す）。
GEMINI_PAID_TIER=false

# オーナー専用管理画面。値はSitesの秘密設定に登録し、ソースには入れない。
ADMIN_OWNER_EMAIL=
API_KEY_ENCRYPTION_SECRET=
